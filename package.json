{
  "name": "proyectois2025-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "yarn --cwd client install && yarn --cwd service install",
    "install:client": "yarn --cwd client install",
    "install:service": "yarn --cwd service install",
    "dev": "concurrently \"yarn --cwd service dev\" \"yarn --cwd client dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}