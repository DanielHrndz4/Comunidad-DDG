    "/tasks/nearby": {
      "get": {
        "summary": "Obtiene tareas cercanas a una coordenada geográfica",
        "tags": [
          "Tareas"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "longitude",
            "required": true,
            "schema": {
              "type": "number"
            },
            "description": "Longitud del punto central (entre -180 y 180)"
          },
          {
            "in": "query",
